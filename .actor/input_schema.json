{
    "title": "Vavada esports odds input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "hubNames": {
            "title": "Game names to scrape",
            "type": "array",
            "description": "If empty, scrape all games. Example: [\"Dota 2\", \"Counter-Strike 2\"]",
            "default": [],
            "editor": "json",
            "items": {
                "type": "string"
            }
        },
        "maxPages": {
            "title": "Maximum pages",
            "type": "integer",
            "description": "0 = all pages.",
            "default": 0
        },
        "proxyUrl": {
            "title": "Proxy URL",
            "type": "string",
            "description": "Optional proxy, e.g. http://user:pass@host:port.",
            "default": "",
            "editor": "textfield"
        }
    },
    "required": []
}
